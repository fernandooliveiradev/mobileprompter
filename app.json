{
  "expo": {
    "name": "MobilePrompter",
    "slug": "mobileprompter",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.fernandopaglacci.mobileprompter",
      "adaptiveIcon": {
        "backgroundColor": "#090D16",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Permitir que o MobilePrompter acesse sua câmera.",
          "microphonePermission": "Permitir que o MobilePrompter acesse seu microfone.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Permitir que o MobilePrompter acesse suas fotos.",
          "savePhotosPermission": "Permitir que o MobilePrompter salve os vídeos gravados na galeria.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      "expo-sharing",
      "expo-audio"
    ]
  }
}
